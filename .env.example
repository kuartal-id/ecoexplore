APP_NAME=Ecoexplore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

# Indonesian first; English via the language toggle.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite (database/database.sqlite). Production (Hostinger): MySQL, e.g.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u000000000_ecoexplore
# DB_USERNAME=u000000000_ecoexplore
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Booking emails. MAIL_MAILER=log writes them to storage/logs/laravel.log (MVP default);
# switch to SMTP (Hostinger mail, Postmark, SES...) before launch.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Business details shown on the site -- [SUPPLY] from the owner. Leave empty until known:
# the site then shows neutral wording instead of invented details.
ECOEXPLORE_CONTACT_EMAIL=
ECOEXPLORE_WHATSAPP=
ECOEXPLORE_LEGAL_ENTITY=
ECOEXPLORE_OPS_EMAIL=
# Manual bank transfer account shown after checkout (all three or none).
ECOEXPLORE_BANK_NAME=
ECOEXPLORE_BANK_ACCOUNT_NAME=
ECOEXPLORE_BANK_ACCOUNT_NUMBER=
# No gateway is integrated yet ("none"). See docs/PAYMENTS.md for the Midtrans plan.
ECOEXPLORE_PAYMENT_GATEWAY=none

# Kuartal ID (id.kuartal.id) -- OAuth/OIDC client for this site. CLIENT_ID/SECRET come from
# `php artisan passport:client` in kuartal-id/kuartal-login for an "ecoexplore-web" client;
# REDIRECT_URI must be registered on that client exactly:
#   https://<production-domain>/auth/kuartal-id/callback
# Until CLIENT_ID is set the "Masuk dengan Kuartal ID" button shows a friendly message.
KUARTAL_ID_BASE_URL=https://id.kuartal.id
KUARTAL_ID_CLIENT_ID=
KUARTAL_ID_CLIENT_SECRET=
KUARTAL_ID_REDIRECT_URI=http://localhost:8000/auth/kuartal-id/callback
# KUARTAL_ID_ISSUER=https://id.kuartal.id
KUARTAL_ID_SCOPES="openid profile email"
